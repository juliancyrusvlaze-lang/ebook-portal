{
  "name": "sintaklat-sanayan",
  "version": "1.0.0",
  "description": "Offline Interactive Ebook Portal at Sanayan",
  "author": "Cyrus Vlaze M. Julian",
  "main": "main.js",
  "scripts": {
    "desktop": "electron .",
    "build:exe": "powershell -ExecutionPolicy Bypass -File ./build-exe.ps1",
    "dist": "electron-builder --win --dir",
    "cap:copy": "npx cap copy android",
    "cap:sync": "npx cap sync android"
  },
  "build": {
    "appId": "com.sintaklat.sanayan",
    "productName": "SintAklat-sanayan",
    "includeSubNodeModules": false,
    "nodeGypRebuild": false,
    "win": {
      "icon": "desktop/app.ico",
      "target": [
        "dir",
        "portable"
      ],
      "sign": false
    },
    "directories": {
      "output": "C:/temp/ebook-dist"
    },
    "files": [
      "main.js",
      "index.html",
      "css/**/*",
      "js/**/*",
      "www/**/*",
      "assets/**/*",
      "desktop/app.ico"
    ]
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
